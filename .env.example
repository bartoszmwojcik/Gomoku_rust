# Copy to .env (git-ignored). Read by gomoku-web and gomoku-db through dotenvy; real environment variables win.
DATABASE_URL=postgresql://gomoku:gomoku@localhost:5432/gomoku
# DATABASE_POOL_MAX=10
# BIND_ADDR=0.0.0.0:3000
# ASSETS_DIR=assets
# RUST_LOG=info

# Environment and proxy. With APP_ENV=production the first two are REQUIRED (the process refuses to start without them:
# the CSRF check and every rate limit depend on them). Without APP_ORIGIN only http://localhost:<port> is accepted as Origin.
# APP_ENV=production
# APP_ORIGIN=https://gomoku.example        # exact origin of the app, no trailing slash
# TRUST_PROXY_HOPS=1                       # number of our own proxies in front of the app (integer >= 1)
# CLIENT_IP_HEADER=x-forwarded-for         # or x-real-ip, cf-connecting-ip
# SESSION_COOKIE_SECURE=false              # default: true in production; not allowed with an https APP_ORIGIN

# argon2id cost (defaults follow OWASP: 19456 KiB, 2 iterations). Lowered only by tests and local experiments.
# PASSWORD_HASH_M_KIB=19456
# PASSWORD_HASH_T_COST=2

# Outgoing mail. Without EMAIL_TRANSPORT sending fails quietly (accounts and games still work; a reset link is never sent).
# EMAIL_TRANSPORT=file                     # dev/tests: append messages as JSON lines to EMAIL_OUTBOX_PATH (refused in production behind https)
# EMAIL_OUTBOX_PATH=.email-outbox.jsonl    # git-ignored; holds full messages with links
# EMAIL_TRANSPORT=brevo                    # production: Brevo transactional API over HTTPS
# BREVO_API_KEY=                           # key limited to transactional mail; a secret, only in the server environment
# EMAIL_FROM_ADDRESS=                      # sender address verified in Brevo
# EMAIL_FROM_NAME=Gomoku                   # sender name (EMAIL_FROM is the older alias)
# EMAIL_DAILY_LIMIT=100                    # per pool (reset, and later verification at 70%); Brevo Free allows ~300/day: at most 176

# Installation administrator: the account with this e-mail. Nobody can register on it and its address never changes through the
# app. (The admin account itself and the panel arrive with the admin CLI/panel; required in production from then on.)
# ADMIN_EMAIL=admin@example.com

# Maintenance. Run hourly from cron on the host (`docker exec <app> /app/gomoku-db cleanup`): deletes expired sessions, counters, one-time links and
# unconfirmed accounts older than 14 days; never the account of ADMIN_EMAIL. Prints one JSON line; exit code 1 when a rule failed.
